---
// 主页面
import "../style/style.scss";

import BaseLayout from "../layouts/BaseLayout.astro";
import Loading from "../components/Loading.astro";
import Background from "../components/Background.astro";
import Description from "../components/Description.astro";
import SocialLinks from "../components/SocialLinks.astro";
import SiteLinks from "../components/SiteLinks.astro";
import Hitokoto from "../components/Hitokoto.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout>
  <!-- 全局状态 & Toast 初始化（内联同步执行，保证最早可用） -->
  <script is:inline>
    // 全局状态
    var STORAGE_KEY = "homepage-data";
    function loadPersistent() {
      try { return JSON.parse(localStorage.getItem(STORAGE_KEY) || "{}"); }
      catch { return {}; }
    }
    window.__STATE__ = {
      imgLoadStatus: false,
      innerWidth: window.innerWidth,
      backgroundShow: false,
    };
    window.saveState = function (key, value) {
      window.__STATE__[key] = value;
      var data = loadPersistent();
      data[key] = value;
      localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
    };
    window.notify = function (eventName, detail) {
      window.dispatchEvent(new CustomEvent(eventName, { detail: detail }));
    };
    window.setInnerWidth = function (value) {
      window.__STATE__.innerWidth = value;
      if (value >= 720) {
        window.__STATE__.mobileOpenState = false;
        window.__STATE__.mobileFuncState = false;
      }
    };

    // Toast 消息
    window.showToast = function (msg, duration) {
      if (typeof msg === "object") { msg = msg.message || ""; duration = duration || msg.duration || 3000; }
      duration = duration || 3000;
      var toast = document.createElement("div");
      toast.className = "toast-message";
      toast.innerHTML = msg;
      toast.style.cssText = "position:fixed;top:20px;left:50%;transform:translateX(-50%);padding:10px 24px;background:rgba(0,0,0,0.4);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border-radius:25px;color:#efefef;font-size:14px;font-family:'HarmonyOS_Regular',sans-serif;z-index:99999;white-space:nowrap;pointer-events:none;animation:toast-in 0.3s ease-out;";
      document.body.appendChild(toast);
      setTimeout(function () {
        toast.style.opacity = "0";
        toast.style.transition = "opacity 0.3s ease-in";
        setTimeout(function () { toast.remove(); }, 300);
      }, duration);
    };
  </script>
  <style is:inline>
    @keyframes toast-in { from { opacity:0; transform:translateX(-50%) translateY(-10px); } to { opacity:1; transform:translateX(-50%) translateY(0); } }
  </style>

  <!-- 加载动画 -->
  <Loading />

  <!-- 壁纸背景 -->
  <Background />

  <!-- 主界面 -->
  <main id="main">
    <div class="container" id="main-container">
      <section class="all" id="main-all">
        <!-- 主面板 -->
        <div class="main-panel" id="main-panel">
          <Description />
          <SocialLinks />
          <Hitokoto />
          <SiteLinks />
        </div>
      </section>
    </div>

    <!-- 页脚 -->
    <Footer />
  </main>

</BaseLayout>

<style>
  #main {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    transform: scale(1.2);
    transition: transform 0.3s;
    animation: fade-blur-main-in 0.65s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
    animation-delay: 0.5s;
    display: none;
  }

  #main.visible {
    display: block;
  }

  .container {
    width: 100%;
    height: 100vh;
    margin: 0 auto;
    padding: 0 0.5vw;
  }

  .all {
    width: 100%;
    min-height: 100%;
    padding: 0 0.75rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  /* 单栏主面板 */
  .main-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
    max-width: 560px;
    width: 100%;
    padding: 40px 20px;
  }


  @media (max-width: 1200px) {
    .container {
      padding: 0 2vw;
    }
  }

  @media (max-width: 720px) {
    .all {
      padding: 0 1rem;
    }
    .main-panel {
      padding: 20px 10px;
      gap: 12px;
    }
  }

  @media (max-height: 720px) {
    #main {
      overflow-y: auto;
      overflow-x: hidden;
    }
    .container {
      min-height: 721px;
    }
  }

  @media (max-width: 390px) {
    #main {
      overflow-x: auto;
    }
    .container {
      width: 391px;
    }
  }
</style>

<script>
  import cursorInit from "../scripts/cursor.js";

  const main = document.getElementById("main");
  const mainContainer = document.getElementById("main-container");

  const S = window.__STATE__;

  // 页面初始化（所有功能入口）
  function initPage() {
    if (main) main.classList.add("visible");

    // 自定义鼠标
    cursorInit();

    // 右键屏蔽
    document.oncontextmenu = () => {
      window.showToast("为了浏览体验，本站禁用右键");
      return false;
    };

    // 中键点击切换壁纸展示
    window.addEventListener("mousedown", (event) => {
      if (event.button === 1) {
        S.backgroundShow = !S.backgroundShow;
        if (mainContainer) {
          mainContainer.style.display = S.backgroundShow ? "none" : "block";
        }
        window.showToast(`已${S.backgroundShow ? "开启" : "退出"}壁纸展示状态`);
      }
    });

    // 控制台彩蛋
    const styleTitle1 = "font-size: 20px;font-weight: 600;color: rgb(244,167,89);";
    const styleTitle2 = "font-size:12px;color: rgb(244,167,89);";
    const styleContent = "color: rgb(30,152,255);";
    console.info(
      `%c無名の主页 %c\n _____ __  __  _______     ____     __\n|_   _|  \\/  |/ ____\\ \\   / /\\ \\   / /\n  | | | \\  / | (___  \\ \\_/ /  \\ \\_/ /\n  | | | |\\/| |\\___ \\  \\   /    \\   /\n _| |_| |  | |____) |  | |      | |\n|_____|_|  |_|_____/   |_|      |_| %c\n\n版本: 4.1.4`,
      styleTitle1, styleTitle2, styleContent
    );
  }

  // 注册 loadComplete 监听（正常流程）
  window.addEventListener("loadComplete", initPage);

  // 兜底：如果 loadComplete 已经触发过（缓存图片导致），直接初始化
  if (S.imgLoadStatus) {
    initPage();
  }

</script>
