---
// 主页面
import "../style/style.scss";

import BaseLayout from "../layouts/BaseLayout.astro";
import Loading from "../components/Loading.astro";
import Background from "../components/Background.astro";
import Description from "../components/Description.astro";
import SocialLinks from "../components/SocialLinks.astro";
import SiteLinks from "../components/SiteLinks.astro";
import Hitokoto from "../components/Hitokoto.astro";
import Footer from "../components/Footer.astro";

const introTitle = import.meta.env.PUBLIC_DESC_INTRO_TITLE || '🙋 关于我';
const introText =
  import.meta.env.PUBLIC_DESC_INTRO_TEXT ||
  '嗨！我是一名热爱技术与生活的全栈开发者，专注于 Web 开发和用户体验设计。这个站点是我在互联网世界的一个小小角落，记录着我的思考、学习和创作。我喜欢探索新技术、阅读、旅行，也享受在开源社区中贡献自己的力量。欢迎常来逛逛，也期待和你交流！';
---

<BaseLayout>
  <!-- 全局状态 & Toast 初始化（内联同步执行，保证最早可用） -->
  <script is:inline>
    // 全局状态
    var STORAGE_KEY = "homepage-data";
    function loadPersistent() {
      try { return JSON.parse(localStorage.getItem(STORAGE_KEY) || "{}"); }
      catch { return {}; }
    }
    window.__STATE__ = {
      imgLoadStatus: false,
      innerWidth: window.innerWidth,
      backgroundShow: false,
    };
    window.saveState = function (key, value) {
      window.__STATE__[key] = value;
      var data = loadPersistent();
      data[key] = value;
      localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
    };
    window.notify = function (eventName, detail) {
      window.dispatchEvent(new CustomEvent(eventName, { detail: detail }));
    };
    window.setInnerWidth = function (value) {
      window.__STATE__.innerWidth = value;
      if (value >= 720) {
        window.__STATE__.mobileOpenState = false;
        window.__STATE__.mobileFuncState = false;
      }
    };

    // Toast 消息
    window.showToast = function (msg, duration) {
      if (typeof msg === "object") { msg = msg.message || ""; duration = duration || msg.duration || 3000; }
      duration = duration || 3000;
      var toast = document.createElement("div");
      toast.className = "toast-message";
      toast.innerHTML = msg;
      toast.style.cssText = "position:fixed;top:20px;left:50%;transform:translateX(-50%);padding:10px 24px;background:rgba(0,0,0,0.4);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border-radius:25px;color:#efefef;font-size:14px;font-family:'HarmonyOS_Regular',sans-serif;z-index:99999;white-space:nowrap;pointer-events:none;animation:toast-in 0.3s ease-out;";
      document.body.appendChild(toast);
      setTimeout(function () {
        toast.style.opacity = "0";
        toast.style.transition = "opacity 0.3s ease-in";
        setTimeout(function () { toast.remove(); }, 300);
      }, duration);
    };
  </script>
  <style is:inline>
    @keyframes toast-in { from { opacity:0; transform:translateX(-50%) translateY(-10px); } to { opacity:1; transform:translateX(-50%) translateY(0); } }
  </style>

  <!-- 加载动画 -->
  <Loading />

  <!-- 壁纸背景 -->
  <Background />

  <!-- 主界面 -->
  <main id="main">
    <div class="container" id="main-container">
      <section class="all" id="main-all">
        <!-- 滑动容器 -->
        <div class="main-slider-wrapper" id="main-slider-wrapper">
          <div class="main-slider" id="main-slider">
            <!-- 左栏：主面板 -->
            <div class="main-panel" id="main-panel">
              <Description />
              <SocialLinks />
              <Hitokoto />
              <SiteLinks />
            </div>

            <!-- 右栏：自我介绍 -->
            <div class="intro-panel" id="intro-panel">
              <div class="intro-content">
                <h3 class="intro-title">{introTitle}</h3>
                <p class="intro-text">{introText}</p>
                <button class="intro-back-btn" id="intro-back-btn">
                  <span class="intro-back-arrow">←</span>
                  <span>返回</span>
                </button>
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>

    <!-- 页脚 -->
    <Footer />
  </main>

</BaseLayout>

<style>
  #main {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    transform: scale(1.2);
    transition: transform 0.3s;
    animation: fade-blur-main-in 0.65s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
    animation-delay: 0.5s;
    display: none;
  }

  #main.visible {
    display: block;
  }

  .container {
    width: 100%;
    height: 100vh;
    margin: 0 auto;
    padding: 0 0.5vw;
  }

  .all {
    width: 100%;
    min-height: 100%;
    padding: 0 0.75rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  /* ===== 滑动容器 ===== */
  .main-slider-wrapper {
    overflow: hidden;
    width: 100%;
  }

  .main-slider {
    display: flex;
    align-items: center;
    gap: 48px;
    width: max-content;
    transition: transform 0.55s cubic-bezier(0.4, 0, 0.2, 1);
    visibility: hidden; /* JS 定位完成后显示 */
    will-change: transform;
  }

  /* ===== 左栏：主面板 ===== */
  .main-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
    width: 560px;
    padding: 40px 20px;
    flex-shrink: 0;
  }

  /* ===== 右栏：自我介绍面板（默认隐藏，展开后显示） ===== */
  .intro-panel {
    width: 460px;
    padding: 40px 28px;
    flex-shrink: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s ease 0.15s;
  }

  .main-slider.is-slid .intro-panel {
    opacity: 1;
    pointer-events: auto;
  }

  .intro-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .intro-title {
    font-size: 1.5rem;
    font-weight: bold;
    color: #fff;
    margin: 0 0 20px;
    font-family: "HarmonyOS_Regular", sans-serif;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  }

  .intro-text {
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.82);
    line-height: 1.9;
    margin: 0 0 32px;
    font-family: "HarmonyOS_Regular", sans-serif;
    text-align: left;
    text-indent: 2em;
  }

  /* 返回按钮 - 毛玻璃效果 */
  .intro-back-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: rgba(255, 255, 255, 0.9);
    padding: 9px 28px;
    border-radius: 24px;
    cursor: pointer;
    font-size: 0.9rem;
    font-family: "HarmonyOS_Regular", sans-serif;
    transition: all 0.3s;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    outline: none;
  }

  .intro-back-btn:hover {
    background: rgba(255, 255, 255, 0.2);
    border-color: rgba(255, 255, 255, 0.35);
    transform: scale(1.05);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
  }

  .intro-back-btn:active {
    transform: scale(0.95);
  }

  .intro-back-arrow {
    font-size: 1rem;
    transition: transform 0.3s;
  }

  .intro-back-btn:hover .intro-back-arrow {
    transform: translateX(-3px);
  }

  /* ===== 响应式 ===== */
  @media (max-width: 1200px) {
    .container {
      padding: 0 2vw;
    }
  }

  @media (max-width: 1200px) {
    .main-panel {
      width: 480px;
    }
    .intro-panel {
      width: 400px;
    }
  }

  @media (max-width: 900px) {
    .main-panel {
      width: 380px;
    }
    .intro-panel {
      width: 340px;
    }
  }

  @media (max-width: 720px) {
    .all {
      padding: 0 1rem;
    }

    .main-slider {
      gap: 28px;
    }

    .main-panel {
      width: calc(100vw - 40px);
      padding: 20px 10px;
      gap: 12px;
    }

    .intro-panel {
      width: calc(100vw - 40px);
      padding: 30px 20px;
    }

    .intro-title {
      font-size: 1.25rem;
      margin-bottom: 16px;
    }

    .intro-text {
      font-size: 0.9rem;
      line-height: 1.75;
      margin-bottom: 24px;
      text-align: left;
    }

    .intro-back-btn {
      padding: 7px 22px;
      font-size: 0.85rem;
    }
  }

  @media (max-height: 720px) {
    #main {
      overflow-y: auto;
      overflow-x: hidden;
    }
    .container {
      min-height: 721px;
    }
  }

  @media (max-width: 390px) {
    #main {
      overflow-x: auto;
    }
    .container {
      width: 391px;
    }
  }
</style>

<script>
  import cursorInit from "../scripts/cursor.js";

  const main = document.getElementById("main");
  const mainContainer = document.getElementById("main-container");

  const S = window.__STATE__;

  // 页面初始化（所有功能入口）
  function initPage() {
    if (main) main.classList.add("visible");

    // 自定义鼠标
    cursorInit();

    // 右键屏蔽
    document.oncontextmenu = () => {
      window.showToast("为了浏览体验，本站禁用右键");
      return false;
    };

    // 中键点击切换壁纸展示
    window.addEventListener("mousedown", (event) => {
      if (event.button === 1) {
        S.backgroundShow = !S.backgroundShow;
        if (mainContainer) {
          mainContainer.style.display = S.backgroundShow ? "none" : "block";
        }
        window.showToast(`已${S.backgroundShow ? "开启" : "退出"}壁纸展示状态`);
      }
    });

    // 控制台彩蛋
    const styleTitle1 = "font-size: 20px;font-weight: 600;color: rgb(244,167,89);";
    const styleTitle2 = "font-size:12px;color: rgb(244,167,89);";
    const styleContent = "color: rgb(30,152,255);";
    console.info(
      `%c無名の主页 %c\n _____ __  __  _______     ____     __\n|_   _|  \\/  |/ ____\\ \\   / /\\ \\   / /\n  | | | \\  / | (___  \\ \\_/ /  \\ \\_/ /\n  | | | |\\/| |\\___ \\  \\   /    \\   /\n _| |_| |  | |____) |  | |      | |\n|_____|_|  |_|_____/   |_|      |_| %c\n\n版本: 4.1.4`,
      styleTitle1, styleTitle2, styleContent
    );

    // 双栏滑动初始化
    initSlider();
  }

  // 注册 loadComplete 监听（正常流程）
  window.addEventListener("loadComplete", initPage);

  // 兜底：如果 loadComplete 已经触发过（缓存图片导致），直接初始化
  if (S.imgLoadStatus) {
    initPage();
  }

  // ===== 双栏滑动逻辑 =====
  function initSlider() {
    const wrapper = document.getElementById("main-slider-wrapper");
    const slider = document.getElementById("main-slider");
    const mainPanel = document.getElementById("main-panel");
    const introPanel = document.getElementById("intro-panel");
    const backBtn = document.getElementById("intro-back-btn");

    if (!wrapper || !slider || !mainPanel || !introPanel) return;

    let isSlid = false;

    function getGap() {
      return window.innerWidth >= 720 ? 48 : 24;
    }

    function applyPosition() {
      const wW = wrapper!.offsetWidth;
      const mW = mainPanel!.offsetWidth;
      const gap = getGap();

      if (isSlid) {
        // 先用 CSS 默认宽度测量，判断双栏能否放下
        introPanel!.style.width = "";
        const iW = introPanel!.offsetWidth;
        const pairW = mW + gap + iW;

        if (pairW > wW) {
          // 移动端：让自我介绍宽度 = wrapper 宽度，完美填充
          introPanel!.style.width = wW + "px";
          slider!.style.transform = `translateX(${-(mW + gap)}px)`;
        } else {
          // 桌面端：双栏对称居中
          slider!.style.transform = `translateX(${(wW - pairW) / 2}px)`;
        }
      } else {
        // 默认：主面板居中
        introPanel!.style.width = "";
        slider!.style.transform = `translateX(${Math.max(0, (wW - mW) / 2)}px)`;
      }

      slider!.classList.toggle("is-slid", isSlid);
    }

    // 初始定位
    applyPosition();
    slider.style.visibility = "visible";

    // LOGO 点击 → 左滑 / 右滑
    window.addEventListener("desc-logo-click", () => {
      isSlid = !isSlid;
      applyPosition();
    });

    // 返回按钮
    backBtn?.addEventListener("click", () => {
      isSlid = false;
      applyPosition();
    });

    // 窗口大小变化时重算（防抖）
    let resizeTimer: ReturnType<typeof setTimeout> | undefined;
    window.addEventListener("resize", () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(applyPosition, 150);
    });
  }
</script>
