---
import '../styles/global.css';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/images/icon/favicon.ico" />
    <meta name="description" content="mcc.im — 个人主页" />
    <meta name="theme-color" content="#424242" />
    <title>mcc.im</title>

    <link rel="preconnect" href="https://s1.hdslb.com" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" />
  </head>
  <body>
    <div id="app">
      <slot name="background" />
      <main id="main">
        <div class="container">
          <div class="all">
            <slot name="left" />
            <slot name="right" />
          </div>
        </div>
        <slot name="footer" />
      </main>
    </div>
  </body>
</html>

<style is:global>
  #main {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    transform: scale(1.2);
    transition: transform 0.3s;
    animation: fade-blur-main-in 0.65s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
    animation-delay: 0.5s;
  }
  #main.loaded {
    /* ready state */
  }
  .container {
    width: 100%;
    height: 100vh;
    margin: 0 auto;
    padding: 0 0.5vw;
    max-width: 1200px;
  }
  .all {
    width: 100%;
    height: 100%;
    padding: 0 0.75rem;
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
  }

  /* Left column */
  .left-col {
    width: 50%;
    margin-right: 10px;
    transform: translateY(20px);
  }
  /* Right column */
  .right-col {
    width: 50%;
    margin-left: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* Right func area — two sub-columns */
  .func-row {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    gap: 20px;
    height: 165px;
  }
  .func-left {
    width: 50%;
  }
  .func-right {
    width: 50%;
  }

  /* Mobile toggle button */
  .menu-btn {
    position: absolute;
    display: none;
    justify-content: center;
    align-items: center;
    bottom: 6%;
    left: calc(50% - 28px);
    width: 56px;
    height: 34px;
    background: rgb(0 0 0 / 20%);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-radius: 6px;
    border: none;
    cursor: pointer;
    transition: transform 0.3s;
    animation: fade 0.5s;
    color: #fff;
    font-size: 18px;
    z-index: 2;
  }
  .menu-btn:active {
    transform: scale(0.95);
  }

  @media (max-width: 1200px) {
    .container { max-width: 1100px; padding: 0 2vw; }
  }
  @media (max-width: 992px) {
    .container { max-width: 900px; }
  }
  @media (max-width: 910px) {
    .func-row { flex-direction: column; height: auto; gap: 14px; }
    .func-left { width: 100%; height: 165px; }
    .func-right { width: 100%; height: 165px; }
  }
  @media (max-width: 720px) {
    .left-col { margin-right: 0; width: 100%; }
    .left-col.hidden { display: none; }
    .right-col { margin-left: 0; width: 100%; }
    .right-col.hidden { display: none; }
    .menu-btn { display: flex; }
  }
  @media (max-height: 720px) {
    #main { overflow-y: auto; overflow-x: hidden; }
    .container { height: 721px; }
  }
  @media (max-width: 390px) {
    #main { overflow-x: auto; }
    .container { width: 391px; }
  }
</style>

<script>
  // ===== Welcome greeting =====
  const hour = new Date().getHours();
  let hello;
  if (hour < 6) hello = '凌晨好';
  else if (hour < 9) hello = '早上好';
  else if (hour < 12) hello = '上午好';
  else if (hour < 14) hello = '中午好';
  else if (hour < 17) hello = '下午好';
  else if (hour < 19) hello = '傍晚好';
  else if (hour < 22) hello = '晚上好';
  else hello = '夜深了';

  // Simple toast-like notification
  const toast = document.createElement('div');
  toast.style.cssText =
    'position:fixed;top:20px;left:50%;transform:translateX(-50%);z-index:9999;' +
    'background:#00000080;backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);' +
    'color:#efefef;padding:8px 20px;border-radius:25px;font-size:14px;' +
    'animation:fade 0.5s;pointer-events:none;white-space:nowrap;';
  toast.innerHTML = `<strong>${hello}</strong> 欢迎来到我的主页`;
  document.body.appendChild(toast);
  setTimeout(() => toast.remove(), 3000);

  // ===== Memorial day detection =====
  const anniversaries = {
    '4.4': '清明节',
    '5.12': '汶川大地震纪念日',
    '7.7': '中国人民抗日战争纪念日',
    '9.18': '九·一八事变纪念日',
    '12.13': '南京大屠杀死难者国家公祭日',
  };

  const now = new Date();
  const key = `${now.getMonth() + 1}.${now.getDate()}`;
  if (anniversaries[key]) {
    const gray = document.createElement('style');
    gray.innerHTML = 'html{filter:grayscale(100%)}';
    document.head.appendChild(gray);

    const memorialToast = document.createElement('div');
    memorialToast.style.cssText = toast.style.cssText;
    memorialToast.style.top = '60px';
    memorialToast.innerHTML = `🕯️ 今天是${anniversaries[key]}`;
    document.body.appendChild(memorialToast);
    setTimeout(() => memorialToast.remove(), 14000);
  }

  // ===== Console easter egg =====
  const styleTitle1 = 'font-size: 20px;font-weight: 600;color: rgb(244,167,89);';
  const styleTitle2 = 'font-size:12px;color: rgb(244,167,89);';
  const styleContent = 'color: rgb(30,152,255);';
  const ascii = `
   _____ __  __  _______     ____     __
  |_   _|  \\/  |/ ____\\ \\   / /\\ \\   / /
    | | | \\  / | (___  \\ \\_/ /  \\ \\_/ /
    | | | |\\/| |\\___ \\  \\   /    \\   /
   _| |_| |  | |____) |  | |      | |
  |_____|_|  |_|_____/   |_|      |_|`;
  console.info(`%cmcc.im%c${ascii}%c\\n\\nAstro 移植版\\nGitHub: https://github.com/Smart-Chou/homepage`, styleTitle1, styleTitle2, styleContent);

  // ===== Right-click message =====
  document.oncontextmenu = () => {
    const rcToast = document.createElement('div');
    rcToast.style.cssText = toast.style.cssText;
    rcToast.textContent = '为了浏览体验，本站禁用右键';
    document.body.appendChild(rcToast);
    setTimeout(() => rcToast.remove(), 2000);
    return false;
  };
</script>
