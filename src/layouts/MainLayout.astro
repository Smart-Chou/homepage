---
import '../styles/global.css';
import '../styles/theme.css';
---

<!doctype html>
<html lang="zh-CN" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>mcc.im</title>
    <link rel="icon" href="/favicon.svg" />
    <meta name="description" content="mcc.im — 个人主页" />

    <!-- Preconnect Google Fonts for faster loading -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body>
    <slot name="toggle" />
    <main class="main">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  .main {
    display: flex;
    flex-direction: column;
    gap: 36px;
    max-width: 600px;
    margin: 0 auto;
    padding: 100px 24px 0;
    min-height: 100vh;
  }
</style>

<script>
  // Intersection Observer — scroll-triggered entrance animations
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    },
    { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
  );

  document.querySelectorAll('.animate-on-enter').forEach((el) => observer.observe(el));
</script>
