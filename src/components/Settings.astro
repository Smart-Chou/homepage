---
// Settings 组件 - 设置面板
---

<div class="settings" id="settings">
  <div class="settings-btn" id="settings-btn" title="设置">
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="3"/>
      <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
    </svg>
  </div>

  <div class="settings-panel" id="settings-panel">
    <div class="settings-header">设置</div>
    <div class="settings-body">
      <div class="setting-group">
        <label class="setting-label">壁纸类型</label>
        <select class="setting-select" id="cover-select">
          <option value="0">随机壁纸</option>
          <option value="1">壁纸 1</option>
          <option value="2">壁纸 2</option>
          <option value="3">壁纸 3</option>
          <option value="4">壁纸 4</option>
          <option value="5">壁纸 5</option>
          <option value="6">壁纸 6</option>
          <option value="7">壁纸 7</option>
          <option value="8">壁纸 8</option>
          <option value="9">壁纸 9</option>
          <option value="10">壁纸 10</option>
        </select>
      </div>
      <div class="setting-group">
        <label class="setting-label">建站日期显示</label>
        <label class="setting-switch">
          <input type="checkbox" id="site-start-toggle" />
          <span class="switch-slider"></span>
        </label>
      </div>
    </div>
  </div>
</div>

<style>
  .settings {
    position: relative;
  }

  .settings-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 6px;
    cursor: pointer;
    color: rgba(255, 255, 255, 0.8);
    transition: background 0.3s, transform 0.3s;
  }

  .settings-btn:hover {
    background: rgba(255, 255, 255, 0.15);
    transform: rotate(30deg);
  }

  .settings-panel {
    position: absolute;
    top: 40px;
    right: 0;
    width: 220px;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(15px);
    border-radius: 8px;
    padding: 14px;
    display: none;
    z-index: 10;
    animation: fade 0.3s ease;
  }

  .settings-panel.open {
    display: block;
  }

  .settings-header {
    font-size: 0.95rem;
    font-weight: bold;
    color: #fff;
    margin-bottom: 12px;
    font-family: "HarmonyOS_Regular", sans-serif;
  }

  .setting-group {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
  }

  .setting-label {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.8);
    font-family: "HarmonyOS_Regular", sans-serif;
  }

  .setting-select {
    padding: 4px 8px;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    font-size: 0.8rem;
    font-family: "HarmonyOS_Regular", sans-serif;
    cursor: pointer;
    outline: none;
  }

  .setting-select option {
    background: #333;
    color: #fff;
  }

  .setting-switch {
    position: relative;
    display: inline-block;
    width: 40px;
    height: 22px;
  }

  .setting-switch input {
    opacity: 0;
    width: 0;
    height: 0;
  }

  .switch-slider {
    position: absolute;
    cursor: pointer;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 22px;
    transition: 0.3s;
  }

  .switch-slider:before {
    content: "";
    position: absolute;
    height: 16px;
    width: 16px;
    left: 3px;
    bottom: 3px;
    background: #fff;
    border-radius: 50%;
    transition: 0.3s;
  }

  input:checked + .switch-slider {
    background: #4facfe;
  }

  input:checked + .switch-slider:before {
    transform: translateX(18px);
  }
</style>

<script>
  const btn = document.getElementById("settings-btn");
  const panel = document.getElementById("settings-panel");
  const coverSelect = document.getElementById("cover-select");
  const siteToggle = document.getElementById("site-start-toggle");

  // 初始化
  coverSelect.value = window.__STATE__?.coverType || "0";
  siteToggle.checked = window.__STATE__?.siteStartShow || false;

  // 切换面板
  btn?.addEventListener("click", (e) => {
    e.stopPropagation();
    panel?.classList.toggle("open");
  });

  // 点击外部关闭
  document.addEventListener("click", (e) => {
    if (!panel?.contains(e.target) && e.target !== btn) {
      panel?.classList.remove("open");
    }
  });

  // 壁纸类型变更
  coverSelect?.addEventListener("change", () => {
    window.saveState("coverType", coverSelect.value);
    window.notify("coverChanged", { type: coverSelect.value });
    panel?.classList.remove("open");
  });

  // 建站日期开关
  siteToggle?.addEventListener("change", () => {
    window.saveState("siteStartShow", siteToggle.checked);
    window.notify("siteStartChanged", { show: siteToggle.checked });
  });
</script>
