---
import socialLinks from '../../config/socialLinks.json';
---

<div id="social-bar" class="social">
  <div class="link">
    {socialLinks.map((item) => (
      <a href={item.url} target="_blank" rel="noopener noreferrer" data-tip={item.tip}>
        <img class="icon" src={item.icon} alt={item.name} height="24" onerror="this.src='data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 24 24%22 fill=%22%23fff%22><circle cx=%2212%22 cy=%2212%22 r=%2210%22 fill=%22none%22 stroke=%22%23fff%22 stroke-width=%222%22/><text x=%2212%22 y=%2216%22 text-anchor=%22middle%22 font-size=%2210%22>?</text></svg>'" />
      </a>
    ))}
  </div>
  <span id="social-tip" class="tip">通过这里联系我吧</span>
</div>

<style>
  .social {
    margin-top: 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 460px;
    width: 100%;
    height: 42px;
    background-color: transparent;
    border-radius: 6px;
    backdrop-filter: blur(0);
    animation: fade 0.5s;
    transition: background-color 0.3s, backdrop-filter 0.3s;
  }
  .link {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .link a {
    display: inherit;
  }
  .icon {
    margin: 0 12px;
    transition: transform 0.3s;
  }
  .icon:hover {
    transform: scale(1.1);
  }
  .icon:active {
    transform: scale(1);
  }
  .tip {
    display: none;
    margin-right: 12px;
    animation: fade 0.5s;
  }
  @media (max-width: 840px) {
    .social {
      max-width: 100%;
      justify-content: center;
    }
    .link {
      justify-content: space-evenly !important;
      width: 90%;
    }
    .tip {
      display: none !important;
    }
  }
  @media (min-width: 768px) {
    .social:hover {
      background-color: #00000040;
      backdrop-filter: blur(5px);
    }
    .social:hover .tip {
      display: block;
    }
  }
</style>

<script>
  // Social tooltip
  const socialBar = document.getElementById('social-bar');
  const socialTip = document.getElementById('social-tip');
  const defaultTip = '通过这里联系我吧';

  socialBar?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('mouseenter', () => {
      if (socialTip) socialTip.textContent = link.dataset.tip || defaultTip;
    });
    link.addEventListener('mouseleave', () => {
      if (socialTip) socialTip.textContent = defaultTip;
    });
  });
</script>
