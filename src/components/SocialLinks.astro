---
import social from '../config/social.json';
import { getIcon } from '../utils/icons';
---

<div class="social-links animate-on-enter delay-3">
  {social.map((item) => (
    <a
      href={item.url}
      target="_blank"
      rel="noopener noreferrer"
      class="social-item"
      title={item.name}
    >
      <span class="social-icon" set:html={getIcon(item.icon)} />
      <span class="social-label">{item.name}</span>
    </a>
  ))}
</div>

<style>
  .social-links {
    max-width: 560px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .social-item {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 10px 20px;
    border-radius: var(--radius-full);
    border: 1px solid var(--border);
    background: var(--card-bg);
    color: var(--text-secondary);
    font-size: 0.85rem;
    font-weight: 500;
    box-shadow: var(--shadow-sm);
    transition:
      transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1),
      color 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease,
      background 0.25s ease;
    text-decoration: none;
    cursor: pointer;
  }
  .social-item:hover {
    transform: translateY(-3px);
    color: var(--accent);
    border-color: var(--accent);
    box-shadow: var(--shadow-md);
    background: var(--accent-soft);
  }
  .social-icon {
    width: 18px;
    height: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .social-icon :global(svg) {
    width: 100%;
    height: 100%;
  }
  .social-label {
    line-height: 1;
  }

  @media (max-width: 450px) {
    .social-links { gap: 8px; }
    .social-item { padding: 8px 14px; font-size: 0.8rem; }
  }
</style>
