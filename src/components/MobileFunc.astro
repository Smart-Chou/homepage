---
// MobileFunc 组件 - 移动端功能区
---

<div class="mobile-func" id="mobile-func">
  <div class="mobile-func-panel" id="mobile-func-panel">
    <div class="mobile-func-content">
      <!-- 时钟 -->
      <div id="mobile-clock"></div>
      <!-- 一言 -->
      <div class="mobile-hito" id="mobile-hito">
        <span id="mobile-hito-text">加载中...</span>
        <span class="mobile-hito-from" id="mobile-hito-from"></span>
      </div>
    </div>
  </div>
</div>

<style>
  .mobile-func {
    display: none;
  }

  @media (max-width: 720px) {
    .mobile-func {
      display: block;
    }

    .mobile-func-panel {
      position: fixed;
      bottom: 60px;
      left: 50%;
      transform: translateX(-50%) translateY(20px);
      width: calc(100% - 32px);
      max-width: 360px;
      background: rgba(0, 0, 0, 0.6);
      backdrop-filter: blur(15px);
      border-radius: 12px;
      padding: 16px;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s, transform 0.3s;
      z-index: 5;
    }

    .mobile-func-panel.open {
      opacity: 1;
      pointer-events: auto;
      transform: translateX(-50%) translateY(0);
    }

    .mobile-func-content {
      text-align: center;
    }

    .mobile-hito {
      margin-top: 12px;
      padding-top: 12px;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
    }

    .mobile-hito span {
      display: block;
      font-size: 0.85rem;
      color: rgba(255, 255, 255, 0.8);
      line-height: 1.5;
      font-family: "HarmonyOS_Regular", sans-serif;
    }

    .mobile-hito-from {
      font-size: 0.75rem !important;
      color: rgba(255, 255, 255, 0.4) !important;
      margin-top: 4px;
    }
  }
</style>

<script>
  import { getCurrentTime } from "../scripts/time";
  import { getHitokoto } from "../scripts/api";

  // 仅在移动端运行
  function isMobile() {
    return window.innerWidth <= 720;
  }

  if (isMobile()) {
    const clockEl = document.getElementById("mobile-clock");
    const hitoText = document.getElementById("mobile-hito-text");
    const hitoFrom = document.getElementById("mobile-hito-from");

    // 简化时钟
    function updateMobileClock() {
      const t = getCurrentTime();
      if (clockEl) {
        clockEl.innerHTML = `<div style="font-family:UnidreamLED,monospace;font-size:1.6rem;color:#fff">
          ${t.hour}:${t.minute}:${t.second}
        </div>
        <div style="font-size:0.8rem;color:rgba(255,255,255,0.5);margin-top:2px">
          ${t.year}年${t.month}月${t.day}日 ${t.weekday}
        </div>`;
      }
    }
    updateMobileClock();
    setInterval(updateMobileClock, 1000);

    // 一言
    async function fetchMobileHito() {
      try {
        const data = await getHitokoto();
        if (hitoText) hitoText.textContent = data.hitokoto;
        if (hitoFrom) hitoFrom.textContent = data.from ? `—— ${data.from}` : "";
      } catch {
        if (hitoText) hitoText.textContent = "加载失败";
      }
    }
    fetchMobileHito();
  }

  // 监听移动端功能区开关
  window.addEventListener("toggleMobileFunc", () => {
    const panel = document.getElementById("mobile-func-panel");
    panel?.classList.toggle("open");
  });
</script>
