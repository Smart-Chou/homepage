---
import profile from '../config/profile.json';
---

<div class="avatar-wrap animate-on-enter">
  <img
    class="avatar-img"
    src={profile.avatar}
    alt={profile.name}
    width="104"
    height="104"
    loading="eager"
    onerror="this.style.background='linear-gradient(135deg, #2563eb, #3b82f6)';this.style.borderRadius='50%'"
  />
</div>

<style>
  .avatar-wrap {
    display: flex;
    justify-content: center;
    padding-top: 8px;
  }
  .avatar-img {
    width: 104px;
    height: 104px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--border);
    box-shadow: var(--shadow-md);
    transition: border-color 0.35s ease, box-shadow 0.35s ease, transform 0.3s ease;
  }
  .avatar-img:hover {
    transform: scale(1.04);
    box-shadow: var(--shadow-lg);
  }
</style>
