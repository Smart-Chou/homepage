---
// TimeCapsule 组件 - 时光胶囊
---

<div class="time-capsule" id="time-capsule">
  <div id="capsule-list"></div>
</div>

<style>
  .time-capsule {
    width: 100%;
  }

  .capsule-item {
    margin-bottom: 12px;
  }

  .capsule-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
  }

  .capsule-name {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.8);
    font-family: "HarmonyOS_Regular", sans-serif;
  }

  .capsule-info {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.5);
    font-family: "HarmonyOS_Regular", sans-serif;
  }

  .capsule-bar {
    width: 100%;
    height: 8px;
    background: rgba(0, 0, 0, 0.2);
    border-radius: 4px;
    overflow: hidden;
  }

  .capsule-fill {
    height: 100%;
    border-radius: 4px;
    transition: width 0.5s ease;
    background: linear-gradient(90deg, #4facfe, #00f2fe);
    text-align: center;
    font-family: "UnidreamLED", monospace;
    font-size: 0.65rem;
    line-height: 8px;
    color: #564d59;
    min-width: 40px;
  }
</style>

<script>
  import { getTimeCapsule } from "../scripts/time";

  function render() {
    const data = getTimeCapsule();
    const el = document.getElementById("capsule-list");
    if (!el) return;

    const items = [data.day, data.week, data.month, data.year];
    el.innerHTML = items
      .map(
        (item) => `
      <div class="capsule-item">
        <div class="capsule-header">
          <span class="capsule-name">${item.name}</span>
          <span class="capsule-info">已过 ${item.passed} / 剩余 ${item.remaining}</span>
        </div>
        <div class="capsule-bar">
          <div class="capsule-fill" style="width:${item.percentage}%">${item.percentage}%</div>
        </div>
      </div>`
      )
      .join("");
  }

  render();
  setInterval(render, 60000);
</script>
