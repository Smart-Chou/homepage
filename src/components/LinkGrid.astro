---
import projects from '../config/projects.json';
import { getIcon } from '../utils/icons';
---

<div class="link-grid animate-on-enter delay-2">
  {projects.map((item) => (
    <a
      href={item.url}
      target="_blank"
      rel="noopener noreferrer"
      class="link-card"
    >
      <span class="link-icon" set:html={getIcon(item.icon)} />
      <span class="link-name">{item.name}</span>
    </a>
  ))}
</div>

<style>
  .link-grid {
    max-width: 560px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
  }
  .link-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding: 24px 14px;
    background: var(--blur-bg);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    color: var(--text);
    transition:
      transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.3s ease,
      border-color 0.3s ease,
      background 0.3s ease;
    text-decoration: none;
    cursor: pointer;
  }
  .link-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg);
    border-color: var(--border-hover);
    background: var(--card-bg);
  }
  .link-icon {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-secondary);
    transition: color 0.25s ease, transform 0.25s ease;
  }
  .link-card:hover .link-icon {
    color: var(--accent);
    transform: scale(1.1);
  }
  .link-icon :global(svg) {
    width: 100%;
    height: 100%;
  }
  .link-name {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text-secondary);
    transition: color 0.25s ease;
  }
  .link-card:hover .link-name {
    color: var(--text);
  }

  @media (max-width: 1024px) {
    .link-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 768px) {
    .link-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }
    .link-card { padding: 20px 12px; }
  }
  @media (max-width: 450px) {
    .link-grid { grid-template-columns: 1fr; }
  }
</style>
