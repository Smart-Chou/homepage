---
// Background 组件 - 壁纸背景
---

<div id="bg" class="bg-container">
  <img
    id="bg-img"
    class="bg-image"
    src=""
    alt="background"
    loading="eager"
  />
  <div id="bg-mask" class="bg-mask"></div>
</div>

<style>
  .bg-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    overflow: hidden;
  }

  .bg-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: fade-blur-in 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
  }

  .bg-mask {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.3);
  }
</style>

<script>
  const bgImg = document.getElementById("bg-img");

  // 随机壁纸
  const num = Math.floor(Math.random() * 10) + 1;
  const url = `/images/background${num}.jpg`;
  const img = new Image();
  img.onload = () => {
    if (bgImg instanceof HTMLImageElement) bgImg.src = url;
    window.dispatchEvent(new CustomEvent("bgLoaded"));
  };
  img.onerror = () => {
    if (bgImg instanceof HTMLImageElement) bgImg.src = "/images/background1.jpg";
    window.dispatchEvent(new CustomEvent("bgLoaded"));
  };
  img.src = url;
</script>
