---
import siteLinks from '../../config/siteLinks.json';
import { getIcon } from '../../utils/icons';
---

<div class="links">
  <div class="line">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" opacity="0.8">
      <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
    </svg>
    <span class="title">网站列表</span>
  </div>
  <div class="link-grid">
    {siteLinks.map((item) => (
      <a href={item.link} target="_blank" rel="noopener noreferrer" class="link-item cards">
        <span class="link-icon" set:html={getIcon(item.icon.toLowerCase())} />
        <span class="link-name text-hidden">{item.name}</span>
      </a>
    ))}
  </div>
</div>

<style>
  .links {
    margin-top: 0;
  }
  .line {
    margin: 2rem 0.25rem 1rem;
    font-size: 1.1rem;
    display: flex;
    align-items: center;
    animation: fade 0.5s;
    gap: 8px;
  }
  .title {
    font-size: 1.15rem;
    text-shadow: 0 0 5px #00000050;
  }
  .link-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }
  .link-item {
    height: 100px;
    display: flex;
    align-items: center;
    flex-direction: row;
    justify-content: center;
    padding: 0 10px;
    gap: 8px;
    animation: fade 0.5s;
    cursor: pointer;
  }
  .link-item:hover {
    transform: scale(1.02);
    background: rgb(0 0 0 / 40%);
    transition: 0.3s;
    text-decoration: none;
  }
  .link-item:active {
    transform: scale(1);
  }
  .link-icon {
    width: 26px;
    height: 26px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .link-icon :global(svg) {
    width: 100%;
    height: 100%;
  }
  .link-name {
    font-size: 1.1rem;
  }
  @media (min-width: 720px) and (max-width: 820px) {
    .link-name { display: none; }
  }
  @media (max-width: 720px) {
    .link-item { height: 80px; }
  }
  @media (max-width: 460px) {
    .link-item {
      flex-direction: column;
    }
    .link-name {
      font-size: 1rem;
      margin-top: 8px;
    }
  }
</style>
